# Kopieren nach .env und Werte anpassen. Die Datei .env wird nicht ins Repository übernommen.
# Nur Buchstaben und Ziffern verwenden (steht in der Datenbank-URL), z. B. aus: openssl rand -hex 32
POSTGRES_PASSWORD=

# Wird beim ersten Start angelegt, solange es noch keinen Benutzer gibt.
# Nach dem ersten Anmelden kann ADMIN_PASSWORT aus der .env entfernt werden.
ADMIN_NAME=Benjamin
ADMIN_EMAIL=deine.adresse@askeorail.de
ADMIN_PASSWORT=

# Mailversand der Berichte über Microsoft 365 (Microsoft Graph). Leer lassen = kein Versand.
# Einrichtung in Microsoft Entra und Exchange: docs/microsoft-365.md
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Postfach, aus dem die Berichte gesendet werden (landen dort unter „Gesendete Elemente“)
MAIL_ABSENDER=vorname.nachname@askeorail.de
